                  <div class="row">
                    <div class="col-12">
                      <div class="card">
                        <div class="card-header">
                          <h3 class="card-title">PERMANENT</h3>
                        </div>
                       
                        <div class="card-body p-0">
                          <div class="table-responsive" style="max-height: 500px; overflow: auto;">
                            <div style="width: 100%; overflow-x: auto;">
                              <div class="scrollable-table">
                                <table id="payrollTable" class="table table-bordered payroll-table">
                                  <thead class="table-header">
                                    <tr>
                                      <th rowspan="3">Serial No.</th>
                                      <th rowspan="3">Name</th>
                                      <th rowspan="3">Position</th>
                                      <th rowspan="3">Employee No.</th>
                                      <th colspan="4" style="text-align: center;">COMPENSATIONS</th>
                                      <th colspan="15" style="text-align: center;">DEDUCTIONS</th>
                                      <th rowspan="3">1st Half Rcd.</th>
                                      <th rowspan="3">2nd Half Rcd.</th>
                                      <th rowspan="3">Action</th>
                                    </tr>
                                    <tr>
                                      <th rowspan="2">Salaries and Wages-Regular</th>
                                      <th rowspan="2">PERA / Subs & Laundry</th>
                                      <th rowspan="2">Adjustment</th>
                                      <th rowspan="2">Gross Amount Earned</th>
                                      <th rowspan="2">W/TAX /(REFUND)</th>
                                      <th colspan="7">GSIS</th>
                                      <th colspan="2">HDMF</th>
                                      <th rowspan="2">PHIL HEALTH/ (ADJ.)</th>
                                      <th rowspan="2">SSS</th>
                                      <th rowspan="2">LBP SL</th>
                                      <th rowspan="2">LWOP / Undertime</th>
                                      <th rowspan="2">Total Deductions</th>
                                    </tr>
                                    <tr>
                                      <th>L & R</th>
                                      <th>CONSO</th>
                                      <th>PLR / PLO</th>
                                      <th>UOLI</th>
                                      <th>E. L. / MPL LITE</th>
                                      <th>GFAL</th>
                                      <th>MPL/CPL</th>
                                      <th>PREMIUM</th>
                                      <th>MPL/CAL/ HOUSING</th>
                                    </tr>
                                  </thead>
                                  <tbody>
                                    <% 
                                    let seriesCount = 1; 
                                    data.permanent.forEach(employee => { 
                                    %>
                                    <tr>
                                      <% 
                                      const empAbsence = data.absences.find(abs => abs._id === employee.empno) || { absencesCount: 0, absenceDates: [] };
                                      const ndays = empAbsence.absencesCount;
                                      const absenceDatesTooltip = empAbsence.absenceDates.join(", ");
                                      const nsalary = Number(employee.salary);
                                      const dsalary = nsalary / 22;
                                      const hsalary = dsalary / 8;
                                      const msalary = hsalary / 60;
                                      const lateEntry = data.lateEntries.find(le => le._id == employee.empno) || { totalLateMinutes: 0 };
                                      const totalLate = Number(lateEntry.totalLateMinutes) || 0;
                                      const remainingMinutes = totalLate % 480;
                                      const nhrs = Math.floor(remainingMinutes / 60);
                                      const nmin = remainingMinutes % 60;
                                      const pera = 2000;
                                      const dailyRatePera = Math.round((pera / 22) * 100) / 100;
                                      const hpera = (dailyRatePera / 8).toFixed(2);
                                      const mpera = (hpera / 60).toFixed(2);
                                      const dsdeduction = dsalary * ndays;
                                      const hsdeduction = hsalary * nhrs;
                                      const msdeduction = msalary * nmin;
                                      const lwop = dsdeduction + hsdeduction + msdeduction;
                                      const stotalDeduction = dsdeduction + hsdeduction + msdeduction;
                                      const dpdeduction = dailyRatePera * ndays;
                                      const hpdeduction = hpera * nhrs;
                                      const mpdeduction = mpera * nmin;
                                      const employeeDeductions = data.deductionsByEmpno[employee.empno] || [];
                                      const totalMandatoryDeductions = employeeDeductions.reduce((sum, deduction) => sum + deduction.avalue, 0);
                                      const ptotalDeduction = dpdeduction + hpdeduction + mpdeduction;
                                      const gtotalDeduction = dpdeduction + hpdeduction + mpdeduction + totalMandatoryDeductions;
                                      
                                      
                                      const ttotaldeduct = ptotalDeduction + totalMandatoryDeductions;
                                      const ssalary = nsalary - totalMandatoryDeductions;
                                      const annualTaxableIncome = ssalary * 12;
                                      let annualTax = 0;
                                      let monthlyTax = 0;
                                      let excess = 0;
                                    
                                      if (annualTaxableIncome <= 250000) {
                                        annualTax = 0;
                                      } else if (annualTaxableIncome <= 400000) {
                                        excess = annualTaxableIncome - 250000;
                                        annualTax = excess * 0.15;
                                      } else if (annualTaxableIncome <= 800000) {
                                        excess = annualTaxableIncome - 400000;
                                        annualTax = 22500 + (excess * 0.20);
                                      } else if (annualTaxableIncome <= 2000000) {
                                        excess = annualTaxableIncome - 800000;
                                        annualTax = 102500 + (excess * 0.25);
                                      } else if (annualTaxableIncome <= 8000000) {
                                        excess = annualTaxableIncome - 2000000;
                                        annualTax = 402500 + (excess * 0.30);
                                      } else {
                                        excess = annualTaxableIncome - 8000000;
                                        annualTax = 2202500 + (excess * 0.35);
                                      }
                                    
                                      monthlyTax = annualTax / 12;

                                      
                                      const gsisDeduction = employeeDeductions
                                        .filter(deduction => deduction.deduction === "gsis")
                                        .reduce((sum, deduction) => sum + deduction.avalue, 0);

                                      const consoDeduction = employeeDeductions
                                        .filter(deduction => deduction.deduction === "gsis-conso")
                                        .reduce((sum, deduction) => sum + deduction.avalue, 0);

                                      const plrDeduction = employeeDeductions
                                        .filter(deduction => deduction.deduction === "gsis-plr")
                                        .reduce((sum, deduction) => sum + deduction.avalue, 0);

                                      const uoliDeduction = employeeDeductions
                                        .filter(deduction => deduction.deduction === "gsis-uoli")
                                        .reduce((sum, deduction) => sum + deduction.avalue, 0);

                                      const gfalDeduction = employeeDeductions
                                        .filter(deduction => deduction.deduction === "gsis-gfal")
                                        .reduce((sum, deduction) => sum + deduction.avalue, 0);

                                      const elmplDeduction = employeeDeductions
                                        .filter(deduction => deduction.deduction === "gsis-elmpl")
                                        .reduce((sum, deduction) => sum + deduction.avalue, 0);

                                      
                                      const premiumDeduction = employeeDeductions
                                        .filter(deduction => deduction.deduction === "hdmf-premium")
                                        .reduce((sum, deduction) => sum + deduction.avalue, 0);

                                      const mplDeduction = employeeDeductions
                                        .filter(deduction => deduction.deduction === "hdmf-mpl")
                                        .reduce((sum, deduction) => sum + deduction.avalue, 0);

                                      
                                      const phicDeduction = employeeDeductions
                                        .filter(deduction => deduction.deduction === "philhealth")
                                        .reduce((sum, deduction) => sum + deduction.avalue, 0);

                                      
                                      const sssDeduction = employeeDeductions
                                        .filter(deduction => deduction.deduction === "sss")
                                        .reduce((sum, deduction) => sum + deduction.avalue, 0);

                                      
                                      const lbpslDeduction = employeeDeductions
                                        .filter(deduction => deduction.deduction === "lbp-sl")
                                        .reduce((sum, deduction) => sum + deduction.avalue, 0);

                                      
                                      const tstotal = nsalary - (stotalDeduction + monthlyTax);
                                      <!-- console.log(monthlyTax + stotalDeduction); -->

                                      %>
                                      <td><strong><%= seriesCount++ %></strong></td>
                                      <td><strong><%= employee.name %></strong></td>
                                      <td><strong><%= employee.serviceRecordPosition %></strong></td>
                                      <td><strong><%= employee.empno %></strong></td>
                                      <td><strong><%= nsalary.toFixed(2) %></strong></td>
                                      <td><strong><%= pera.toFixed(2) %></strong></td>
                                      <td>-</td>
                                      <td><strong><%= (nsalary + pera).toFixed(2) %></strong></td>
                                      <td><strong><%= monthlyTax.toFixed(2) %></strong></td>
                                      <td><strong><%= gsisDeduction.toFixed(2) %></strong></td>
                                      <td><strong>  <%= consoDeduction.toFixed(2) %></strong></td>
                                      <td><strong>  <%= plrDeduction.toFixed(2) %></strong></td>
                                      <td><strong>  <%= uoliDeduction.toFixed(2) %></strong></td>
                                      <td><strong>  <%= elmplDeduction.toFixed(2) %></strong></td>
                                      <td><strong>  <%= gfalDeduction.toFixed(2) %></strong></td>
                                      <td><strong>  <%= mplDeduction.toFixed(2) %></strong></td>
                                      <td><strong>  <%= premiumDeduction.toFixed(2) %></strong></td>
                                      
                                      <td><strong>  <%= mplDeduction.toFixed(2) %></strong></td>

                                      <td><%= phicDeduction.toFixed(2) %></td>
                                      <td><%= sssDeduction.toFixed(2) %></td>
                                      <td><%= lbpslDeduction.toFixed(2) %></td>
                                      
                                      <td><%= (totalMandatoryDeductions + stotalDeduction).toFixed(2) %></td>
                                      <td><%= (monthlyTax + gsisDeduction + consoDeduction +plrDeduction+uoliDeduction+elmplDeduction+gfalDeduction+mplDeduction+premiumDeduction+phicDeduction+sssDeduction+lbpslDeduction+stotalDeduction + ptotalDeduction).toFixed(2) %></td>
                                      <td><%= (tstotal/2 +2000).toFixed(0) %></td>
                                      
                                      <td><%= (tstotal/2).toFixed(2) %></td>
                                      <td><button id="modify">modify</button> </td>
                                    </tr>
                                    <% }); %>
                                   
                                    <tr class="total-row">
                                      <td colspan="4">TOTAL</td>
                                      <td>114,685.00</td>
                                      <td>4,000.00</td>
                                      <td>-</td>
                                      <td>68,775.00</td>
                                      <td>2,273.25</td>
                                      <td>5,874.50</td>
                                      <td>1,600.00</td>
                                      <td>-</td>
                                      <td>-</td>
                                      <td>-</td>
                                      <td>4,627.58</td>
                                      <td>800.00</td>
                                      <td>2,892.92</td>
                                      <td>813.22</td>
                                      <td>-</td>
                                      <td>107.81</td>
                                      <td>17,734.26</td>
                                      <td>27,653.00</td>
                                      <td>23,661.94</td>
                                      <td colspan="2"></td>
                                      
                                    </tr>
                                  </tbody>
                                </table>
                              </div>
                            </div>
                          </div>
                        </div>
                        
                       
                        <button id="downloadExcel" class="btn btn-primary">Download as Excel</button>
                        
                       
                        <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
                        
                        <script>
                          document.getElementById('downloadExcel').addEventListener('click', function () {
                            const table = document.getElementById('payrollTable');                                                  
                            const rows = Array.from(table.querySelectorAll('tr'));
                            const data = rows.map(row => {
                              const cells = Array.from(row.querySelectorAll('th, td'));
                              return cells.map(cell => cell.innerText.trim());
                            });                                                  
                            const wb = XLSX.utils.book_new();
                            const ws = XLSX.utils.aoa_to_sheet(data);                                                  
                            XLSX.utils.book_append_sheet(wb, ws, 'Payroll Data');                                                  
                            XLSX.writeFile(wb, 'Payroll_Report.xlsx');
                          });
                        </script>
                       
                      </div>
                    </div>
                  </div>
                </div>
              </section>
             
              <section class="content">
                <div class="container-fluid">
                  <div class="row">
                    <div class="col-12">
                      <div class="card">
                        <div class="card-header">
                          <h3 class="card-title">COS</h3>
                        </div>
                       
                        <div class="card-body">
                          <table id="faculty" class="table table-bordered table-striped mb-0" style="table-layout: fixed; width: 100%;">
                            <thead style="position: sticky; top: 0; background-color: #f8f9fa; z-index: 1;">
                              <tr>
                                
                                <th style="width: 120px;">Name</th>
                                <th colspan="3" style="width: 180px;">Time</th>
