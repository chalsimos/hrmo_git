       <script>
document.addEventListener("DOMContentLoaded", function () {
    document.querySelector("table").addEventListener("click", async function (event) {
        const target = event.target;
        if (target.tagName === "BUTTON" && target.textContent.trim() === "modify") {
            const row = target.closest("tr"); 
            const cells = row.querySelectorAll("td:not(:last-child)"); 

            
            cells.forEach(cell => {
                const value = cell.textContent.trim(); 
                cell.innerHTML = `<input type="text" value="${value}" />`; 
            });            
            target.textContent = "save";
            target.onclick = async function () {
                const updatedData = {};
                cells.forEach((cell, index) => {
                    const input = cell.querySelector("input");
                    updatedData[`field${index}`] = input.value; 
                });

                
                try {
                    const response = await fetch('/update-single-payroll', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(updatedData)
                    });

                    if (response.ok) {
                        
                        const result = await response.json();

                        
                        cells.forEach(cell => {
                            const input = cell.querySelector("input");
                            cell.textContent = input.value; 
                        });

                        
                        target.textContent = "modify";

                        
                        target.onclick = null; 
                        target.addEventListener("click", arguments.callee); 

                        console.log("Data updated successfully:", result);
                    } else {
                        console.error("Failed to update data:", response.statusText);
                        alert("Failed to update data. Please try again.");
                    }
                } catch (error) {
                    console.error("Error during POST request:", error);
                    alert("An error occurred while updating the data.");
                }
            };
        }
    });
});

        
