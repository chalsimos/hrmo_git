                            <tbody>
                              <% data.jobOrder.forEach(employee => { %>
                                <tr>
                                  <% 
                                  const empAbsence = data.absences.find(abs => abs._id === employee.empno) || { absencesCount: 0, absenceDates: [] };
                                  const ndays = empAbsence.absencesCount;
                                  const absenceDatesTooltip = empAbsence.absenceDates.join(", ");
                                    const nsalary = Number(employee.salary);
                                    const dsalary = nsalary / 22;
                                    const hsalary = dsalary / 8;
                                    const msalary = hsalary / 60;
                                
                                   
                                    const lateEntry = data.lateEntries.find(le => le._id == employee.empno) || { totalLateMinutes: 0 };
                                
                                    const totalLate = Number(lateEntry.totalLateMinutes) || 0;
                                   
                                    const remainingMinutes = totalLate % 480;
                                    const nhrs = Math.floor(remainingMinutes / 60);
                                    const nmin = remainingMinutes % 60;
                                
                                    const pera = 2000;
                                    const dailyRatePera = Math.round((pera / 22) * 100) / 100;
                                    const hpera = (dailyRatePera / 8).toFixed(2);
                                    const mpera = (hpera / 60).toFixed(2);
                                
                                    const dsdeduction = dsalary * ndays;
                                    const hsdeduction = hsalary * nhrs;
                                    const msdeduction = msalary * nmin;
                                    const stotalDeduction = dsdeduction + hsdeduction + msdeduction;
                                
                                    const dpdeduction = dailyRatePera * ndays;
                                    const hpdeduction = hpera * nhrs;
                                    const mpdeduction = mpera * nmin;
                                   
                                   
                                   
                                    const employeeDeductions = data.deductionsByEmpno[employee.empno] || [];
                                      const totalMandatoryDeductions = employeeDeductions.reduce((sum, deduction) => sum + deduction.avalue, 0);
                                      const ptotalDeduction = dpdeduction + hpdeduction + mpdeduction ;
                                      const gtotalDeduction = dpdeduction + hpdeduction + mpdeduction + totalMandatoryDeductions;
                                  %>
                                  
                                  <td><%= employee.name %></td>
                                  <td> <span 
                                    data-bs-toggle="tooltip" 
                                    data-bs-html="true" 
                                    title="Absent Dates: <%= absenceDatesTooltip %>">
                                    <%= ndays %>
                                  </span></td>
                                  <td><%= nhrs %></td>
                                  <td><%= nmin %></td>
                                
                                  <td><%= nsalary.toFixed(2) %></td>
                                  <td><%= dsalary.toFixed(2) %></td>
                                  <td><%= hsalary.toFixed(2) %></td>
                                  <td><%= msalary.toFixed(2) %></td>
                                  <td><%= pera.toFixed(2) %></td>
                                  <td><%= dailyRatePera.toFixed(2) %></td>
                                  <td><%= hpera %></td>

                                  <td><%= stotalDeduction.toFixed(2) %></td>
                                  <td><%= dpdeduction.toFixed(2) %></td>
                                  <td><%= hpdeduction.toFixed(2) %></td>
                                  <td><%= mpdeduction.toFixed(2) %></td>
                                  <td><%= ptotalDeduction.toFixed(2) %></td>
                                  <td>
                                    <% 
                                    
                                     
                                     
                                      
                                    %>
                                    <% if (employeeDeductions.length > 0) { %>
                                      <ul>
                                        <% employeeDeductions.forEach(deduction => { %>
                                          <li>
                                            <%= deduction.deduction %>: <%= helpers.formatCurrency(deduction.avalue) %>
                                          </li>
                                        <% }); %>
                                      </ul>
                                      total: <%= totalMandatoryDeductions.toFixed(2) %>
                                    <% } else { %>
                                      <p>No mandatory deductions</p>
                                    <% } %>
                                  </td>
                                  <td 
                                  data-bs-toggle="tooltip" 
                                  data-bs-html="true" 
                                  title="Mandatory Deductions: <%= totalMandatoryDeductions.toFixed(2) %>|| Salary Deduction: <%= stotalDeduction.toFixed(2) %> || PERA Deduction: <%= ptotalDeduction.toFixed(2) %>">
                                  <%= totalMandatoryDeductions.toFixed(2) %> + <%= (stotalDeduction + ptotalDeduction).toFixed(2) %> =
                                  <%= (totalMandatoryDeductions + stotalDeduction + ptotalDeduction).toFixed(2) %>
                                </td>
                                    <td><a href="/filteryear?empno=<%= employee.empno %>&year=<%= year %>&month=<%= month %>">modify</a>
                                  </td>
                                </tr>
                                <% }); %>
                                
                          </tbody>
              
                         
                         
              
                         
