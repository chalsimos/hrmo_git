<%- include('../partials/top') %>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper"> 
        <%- include('partials/nav') %>
        <%- include('partials/aside') %>
        <div class="content-wrapper">
            <section class="content-header">
                <div class="container-fluid">
                  <div class="row mb-2">
                    <div class="col-sm-6">
                      <h1>Employee</h1>
                    </div>
                    <div class="col-sm-6">
                      <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item active">employee</li>
                      </ol>
                    </div>
                  </div>
                </div><!-- /.container-fluid -->
              </section>
      
              <section class="content">
                <div class="container-fluid">
                  <div class="row">
                    <div class="col-12">
                      <div class="card">
                        <div class="card-header">
                          <h3 class="card-title">Employee Listings</h3>
                        </div>
                        <!-- /.card-header -->
                        <div class="card-body">
                         <h3>Employee Deductions</h3>
                         <button>Upload Multiple</button>
                          <table id="faculty" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                <th>#</th>
                                <th>Employee No.</th>
                                <th>Name</th>
                                <th>Deductions</th>
                                <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
 <% employees.forEach((employee, index) => { %>
  <tr>
    <td><%= index + 1 %></td>
    <td><%= employee.empno %></td>
    <td><%= employee.lname %>, <%= employee.fname %></td>
    <td>
      <% if (employee.itemizedDeductions.length > 0) { %>
        <ul>
          <% employee.itemizedDeductions.forEach(deduction => { %>
            <li><%= deduction.name %>: <%= deduction.value %></li>
          <% }) %>
        </ul>
      <% } else { %>
        No Deductions
      <% } %>
    </td>
    <td>
      <a 
        href="#" 
        class="pritil modify-btn" 
        data-toggle="modal" 
        data-target="#modifyDeductions" 
        data-empno="<%= employee.empno %>" 
        data-deductions='<%= JSON.stringify(employee.deductions || []) %>'>
        Modify
      </a>
    </td>
  </tr>
<% }) %>

</tbody>

                            <tfoot>
                                <tr>
                                <th>#</th>
                                <th>Employee No.</th>
                                <th>Name</th>
                                <th>Deductions</th>
                                <th>Action</th>
                                </tr>
                            </tfoot>
                            </table>

              
                          <!-- Add Book Dialog Modal -->
<div id="modifyDeductions" class="modal fade" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Modify Deductions for Employee #<span id="modal-empno"></span></h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label for="name">Deduction Name</label>
          <!-- <input type="text" name="name" id="name" class="form-control" placeholder="Enter deduction name"> -->
           <select name="name" id="name" class="form-control">
            <option value="unpaidPremium">GSIS - Unpaid Premium</option>
            <option value="calamityEl">GSIS - CALAMITY / EL</option>
            <option value="computerLoan">GSIS - Computer Loan / EL</option>
            <option value="gsis lr">GSIS - LR</option>
            <option value="gsis conso">GSIS - CONSO</option>
            <option value="gsis plr">GSIS - PLR</option>
            <option value="gsis uoli">GSIS - UOLI</option>
            <option value="gsis elmpl">GSIS - EL/MPL</option>
            <option value="gsis gfal">GSIS - GFAL</option>
            <option value="gsis mplcpl">GSIS - MPL/CPL</option>
            <option value="hmdf premium">HMDF - PREMIUM</option>
            <option value="hmdf mpl">HMDF - MPL</option>
            <option value="philhealth">PHILHEALTH</option>
            <option value="sss">SSS</option>
            <option value="lbpsl">LBPSL</option>
            <option value="lwop">LWOP</option>
           </select>
        </div>
        <div class="form-group">
          <label for="avalue">Amount</label>
          <input type="number" name="avalue" id="avalue" class="form-control" placeholder="Enter amount">
        </div>
        <button id="addDeductionBtn" class="btn btn-success">Add Deduction</button>
        <hr>
        <table class="table">
          <thead>
            <tr>
              <th>Deduction</th>
              <th>Amount</th>
            </tr>
          </thead>
          <tbody id="deductions-table">
            <!-- Deductions will be populated here -->
          </tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </div>
    </div>
  </div>
</div>


                          <!-- Modal 2 (Modify Employee Modal) -->
                          <div id="modal2" class="modal">
                            <div class="modal-dialog">
                              <div class="modal-content">
                                <div class="modal-header">
                                  <h5 class="modal-title">Modify</h5>
                                  <span class="close" onclick="closeModal('modal2')">&times;</span>
                                </div>
                                <div class="modal-body">
                                  <form id="myForm" method="post" action='/modifyemp'>
                                    <input type="hidden" id="sid" name="emp">
                                    <div class="row">
                                      <div class="col-lg-4">
                                        <label>LastName</label>
                                        <input type="text" name="lastName" id="lastName" class="form-control">
                                      </div>
                                      <div class="col-lg-4">
                                        <label>FirstName</label>
                                        <input type="text" name="firstName" id="firstName" class="form-control">
                                      </div>
                                      <div class="col-lg-3">
                                        <label>Middle Initial</label>
                                        <input type="text" name="middleName" id="middleName" class="form-control">
                                      </div>
                                    </div>
                                    <div class="row">
                                      <div class="col-lg-3">
                                        <label>EmpID</label>
                                        <input type="text" name="empid" id="empid" class="form-control">
                                      </div>
                                      <div class="col-lg-5">
                                        <label>Department</label>
                                        <select class="form-control" name="dept" required>
                                          <option value="ADMIN">ADMIN</option>
                                          <option value="JOBORDER">JOB ORDER</option>
                                          <option value="NONPERMANENT">NON-PERMANENT</option>
                                          <option value="FACULTY">FACULTY</option>
                                        </select>
                                      </div>
                                      <div class="col-lg-3">
                                        <label>Status</label>
                                        <select class="form-control" name="status" required>
                                          <option value="active">active</option>
                                          <option value="inactive">inactive</option>
                                        </select>
                                      </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                  <button type="submit" class="btn btn-primary">save changes</button>
                                </div>
                              </form>
                              </div>
                            </div>
                          </div>
              
                        </div>
                        <!-- /.card-body -->
                      </div>
                    </div>
                  </div>
                </div>
              </section>
              
          </div>
        </div>
        <%- include('../partials/end') %>
     <script>
 document.addEventListener("DOMContentLoaded", () => {
  const addDeductionBtn = document.getElementById("addDeductionBtn");
  const modifyButtons = document.querySelectorAll(".modify-btn");

  // Add Deduction Functionality
  addDeductionBtn.addEventListener("click", async () => {
    const empno = document.getElementById("modal-empno").textContent.trim();
    const name = document.getElementById("name").value.trim();
    const avalue = document.getElementById("avalue").value.trim();

    if (!name || !avalue) {
      alert("Please fill in all fields!");
      return;
    }

    try {
      const response = await fetch("/add-deduction", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ empno, name, avalue }),
      });

      if (response.ok) {
        const newDeduction = await response.json();

        const deductionsTable = document.getElementById("deductions-table");
        const newRow = document.createElement("tr");
        newRow.innerHTML = `
          <td>${newDeduction.deduction}</td>
          <td>₱${Number(newDeduction.avalue).toFixed(2)}</td>
          <td><button class="btn btn-danger delete-deduction">x</button></td>
        `;
        deductionsTable.appendChild(newRow);

        // Add delete event listener for the new button
        attachDeleteListener(newRow.querySelector(".delete-deduction"));

        document.getElementById("name").value = "";
        document.getElementById("avalue").value = "";
      } else {
        alert("Failed to add deduction. Please try again.");
      }
    } catch (error) {
      console.error("Error adding deduction:", error);
      alert("An error occurred. Please check the console.");
    }
  });

  // Attach event listeners to modify buttons
  modifyButtons.forEach(button => {
    button.addEventListener("click", function () {
      const empno = this.dataset.empno;
      const deductions = JSON.parse(this.dataset.deductions || "[]");

      document.getElementById("modal-empno").textContent = empno;

      const deductionsTable = document.getElementById("deductions-table");
      deductionsTable.innerHTML = "";

      deductions.forEach(deduction => {
        const row = document.createElement("tr");
        row.innerHTML = `
          <td>${deduction.deduction}</td>
          <td>₱${Number(deduction.avalue).toFixed(2)}</td>
          <td><button class="btn btn-danger delete-deduction">x</button></td>
        `;
        deductionsTable.appendChild(row);

        // Add delete event listener
        attachDeleteListener(row.querySelector(".delete-deduction"));
      });
    });
  });

  // Function to attach delete logic to buttons
  function attachDeleteListener(button) {
    button.addEventListener("click", async function () {
      const empno = document.getElementById("modal-empno").textContent.trim();
      const deductionRow = this.closest("tr");
      const deductionName = deductionRow.querySelector("td:first-child").textContent.trim();

      if (confirm("Are you sure you want to delete this deduction?")) {
        try {
          const response = await fetch("/delete-deduction", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ empno, deductionName }),
          });

          if (response.ok) {
            deductionRow.remove(); // Remove the row from the table
            alert("Deduction deleted successfully.");
          } else {
            alert("Failed to delete deduction. Please try again.");
          }
        } catch (error) {
          console.error("Error deleting deduction:", error);
          alert("An error occurred. Please check the console.");
        }
      }
    });
  }
});

</script>
