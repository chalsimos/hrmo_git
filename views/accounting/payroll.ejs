                                          <li>
                                            <%= deduction.deduction %>: <%= helpers.formatCurrency(deduction.avalue) %>
                                          </li>
                                        <% }); %>
                                      </ul>
                                      total: <%= totalMandatoryDeductions.toFixed(2) %>
                                    <% } else { %>
                                      <p>No mandatory deductions</p>
                                    <% } %>
                                  </td>
                                  <td 
                                  data-bs-toggle="tooltip" 
                                  data-bs-html="true" 
                                  title="Mandatory Deductions: <%= totalMandatoryDeductions.toFixed(2) %>|| Salary Deduction: <%= stotalDeduction.toFixed(2) %> || PERA Deduction: <%= ptotalDeduction.toFixed(2) %>">
                                  <%= totalMandatoryDeductions.toFixed(2) %> + <%= (stotalDeduction + ptotalDeduction).toFixed(2) %> =
                                  <%= (totalMandatoryDeductions + stotalDeduction + ptotalDeduction).toFixed(2) %>
                                </td>
                                    <td><a href="/filteryear?empno=<%= employee.empno %>&year=<%= year %>&month=<%= month %>">modify</a>
                                  </td>
                                </tr>
                                <% }); %>
                                
                          </tbody>
              
