<%- include('../partials/top') %>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper"> 
        <%- include('partials/nav') %>
        <%- include('partials/aside') %>
        <div class="content-wrapper">
            <section class="content-header">
                <div class="container-fluid">
                  <div class="row mb-2">
                    <div class="col-sm-6">
                      <h1>Payroll</h1>
                    </div>
                    <div class="col-sm-6">
                      <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item active">payroll</li>
                      </ol>
                    </div>
                  </div>
                </div><!-- /.container-fluid -->
              </section>
      
             <section class="content">
                <div class="container-fluid">
                   
                    
            
                  <div class="row">
                    <div class="col-12">
                      <% if (typeof successMessage !== 'undefined' && successMessage.length > 0) { %>
                        <div class="alert alert-success">
                          <%= successMessage %>
                        </div>
                      <% } %>

                      <% if (typeof errorMessage !== 'undefined' && errorMessage.length > 0) { %>
                        <div class="alert alert-danger">
                          <%= errorMessage %>
                        </div>
                      <% } %>
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-12">
                      <div class="card">
                        <div class="card-header">
                          <h3 class="card-title">PERMANENT</h3>
                        </div>
                       
                        <div class="card-body p-0">
                          <div class="table-responsive" style="max-height: 500px; overflow: auto;">
                            <div style="width: 100%; overflow-x: auto;">
                              <div class="scrollable-table">
                                <table id="payrollTable" class="table table-bordered payroll-table">
                                  <thead class="table-header">
                                    <tr>
                                      <th rowspan="3">Serial No.</th>
                                      <th rowspan="3">Name</th>
                                      <th rowspan="3">Position</th>
                                      <th rowspan="3">Employee No.</th>
                                      <th colspan="4" style="text-align: center;">COMPENSATIONS</th>
                                      <th colspan="15" style="text-align: center;">DEDUCTIONS</th>
                                      <th rowspan="3">1st Half Rcd.</th>
                                      <th rowspan="3">2nd Half Rcd.</th>
                                      <th rowspan="3">Action</th>
                                    </tr>
                                    <tr>
                                      <th rowspan="2">Salaries and Wages-Regular</th>
                                      <th rowspan="2">PERA / Subs & Laundry</th>
                                      <th rowspan="2">Adjustment</th>
                                      <th rowspan="2">Gross Amount Earned</th>
                                      <th rowspan="2">W/TAX /(REFUND)</th>
                                      <th colspan="7">GSIS</th>
                                      <th colspan="2">HDMF</th>
                                      <th rowspan="2">PHIL HEALTH/ (ADJ.)</th>
                                      <th rowspan="2">SSS</th>
                                      <th rowspan="2">LBP SL</th>
                                      <th rowspan="2">LWOP / Undertime</th>
                                      <th rowspan="2">Total Deductions</th>
                                    </tr>
                                    <tr>
                                      <th>L & R</th>
                                      <th>CONSO</th>
                                      <th>PLR / PLO</th>
                                      <th>UOLI</th>
                                      <th>E. L. / MPL LITE</th>
                                      <th>GFAL</th>
                                      <th>MPL/CPL</th>
                                      <th>PREMIUM</th>
                                      <th>MPL/CAL/ HOUSING</th>
                                    </tr>
                                  </thead>
                                  <tbody>
                                    <% 
                                    let seriesCount = 1; 
                                    if (data.permanent && data.permanent.length > 0) {
                                      data.permanent.forEach(item => { 
                                        const salary = parseFloat(item.salary || 0);
                                        const deductions = [
                                          item.tax,
                                          item.deductions?.gsis?.lr,
                                          item.deductions?.gsis?.conso,
                                          item.deductions?.gsis?.plr,
                                          item.deductions?.gsis?.uoli,
                                          item.deductions?.gsis?.elmpl,
                                          item.deductions?.gsis?.gfal,
                                          item.deductions?.gsis?.mplcpl,
                                          item.deductions?.hmdf?.premium,
                                          item.deductions?.hmdf?.hdmfmpl,
                                          item.deductions?.philhealth,
                                          item.deductions?.sss,
                                          item.deductions?.lbpsl,
                                          item.deductions?.lwop
                                        ].map(d => parseFloat((d || "0").replace(/,/g, ''))); // remove commas
                                  
                                        const totalDeductions = deductions.reduce((a, b) => a + b, 0);
                                        const halfPay = ((salary - totalDeductions) / 2).toFixed(2);
                                    %>
                                    <tr>
                                      <td><%= seriesCount++ %></td>
                                      <td><%= item.name %></td>
                                      <td><%= item.serviceRecordPosition %></td>
                                      <td><%= item.empno %></td>
                                  
                                      <!-- COMPENSATIONS -->
                                      <td><%= item.salary || '-' %></td> <!-- Salaries and Wages-Regular -->
                                      <td>-</td> <!-- PERA / Subs & Laundry -->
                                      <td>-</td> <!-- Adjustment -->
                                      <td><%= item.salary || '-' %></td> <!-- Gross Amount Earned -->
                                  
                                      <!-- DEDUCTIONS -->
                                      <td><%= item.tax || '-' %></td> <!-- W/TAX -->
                                      <td><%= item.deductions.gsis?.lr || '-' %></td>
                                      <td><%= item.deductions.gsis?.conso || '-' %></td>
                                      <td><%= item.deductions.gsis?.plr || '-' %></td>
                                      <td><%= item.deductions.gsis?.uoli || '-' %></td>
                                      <td><%= item.deductions.gsis?.elmpl || '-' %></td>
                                      <td><%= item.deductions.gsis?.gfal || '-' %></td>
                                      <td><%= item.deductions.gsis?.mplcpl || '-' %></td>
                                  
                                      <td><%= item.deductions.hmdf?.premium || '-' %></td>
                                      <td><%= item.deductions.hmdf?.hdmfmpl || '-' %></td>
                                      
                                      <td><%= item.deductions.philhealth || '-' %></td>
                                      <td><%= item.deductions.sss || '-' %></td>
                                      <td><%= item.deductions.lbpsl || '-' %></td>
                                      <td><%= item.deductions.lwop || '-' %></td>
                                      <td><%= item.totaldeductions || '-' %></td>
                                  
                                      <!-- RECEIPTS + ACTION -->
                                      <td><%= (parseFloat(halfPay) + 2000).toFixed(2) %></td>
                                      <td><%= halfPay %></td>
                                      <td><button id="modify" class="btn btn-sm btn-primary">Modify</button></td>
                                    </tr>
                                    <% }); 
                                    } else { %>
                                      <tr>
                                        <td colspan="25" class="text-center">No payroll data found for the selected month and year.</td>
                                      </tr>
                                    <% } %>
                                  
                                    <!-- Example static TOTAL row (you may calculate this on server-side if needed) -->
                                    <tr class="total-row">
                                      <td colspan="4">TOTAL</td>
                                      <td>114,685.00</td>
                                      <td>4,000.00</td>
                                      <td>-</td>
                                      <td>68,775.00</td>
                                      <td>2,273.25</td>
                                      <td>5,874.50</td>
                                      <td>1,600.00</td>
                                      <td>-</td>
                                      <td>-</td>
                                      <td>-</td>
                                      <td>4,627.58</td>
                                      <td>800.00</td>
                                      <td>2,892.92</td>
                                      <td>813.22</td>
                                      <td>-</td>
                                      <td>107.81</td>
                                      <td>17,734.26</td>
                                      <td>27,653.00</td>
                                      <td>23,661.94</td>
                                      <td colspan="2"></td>
                                    </tr>
                                  
                                  </tbody>
                                </table>
                              </div>
                            </div>
                          </div>
                        </div>
                        
                       
                        <button id="downloadExcel" class="btn btn-primary">Download as Excel</button>
                        
                       
                        <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
                        
                        <script>
                          document.getElementById('downloadExcel').addEventListener('click', function () {
                            const table = document.getElementById('payrollTable');                                                  
                            const rows = Array.from(table.querySelectorAll('tr'));
                            const data = rows.map(row => {
                              const cells = Array.from(row.querySelectorAll('th, td'));
                              return cells.map(cell => cell.innerText.trim());
                            });                                                  
                            const wb = XLSX.utils.book_new();
                            const ws = XLSX.utils.aoa_to_sheet(data);                                                  
                            XLSX.utils.book_append_sheet(wb, ws, 'Payroll Data');                                                  
                            XLSX.writeFile(wb, 'Payroll_Report.xlsx');
                          });
                        </script>
                       
                      </div>
                    </div>
                  </div>
                </div>
              </section>
             
               
              
          </div>
        </div>
       <script>
document.addEventListener("DOMContentLoaded", function () {
    const table = document.querySelector("#payrollTable");

    table.addEventListener("click", async function (event) {
        const target = event.target;

        // Handle "Modify" click
        if (target.tagName === "BUTTON" && target.textContent.trim().toLowerCase() === "modify") {
            const row = target.closest("tr");
            const cells = row.querySelectorAll("td:not(:last-child)");

            // Change cells to input fields
            cells.forEach(cell => {
                const value = cell.textContent.trim();
                cell.innerHTML = `<input type="text" class="form-control form-control-sm" value="${value}" />`;
            });

            target.textContent = "Save";
        }

        // Handle "Save" click
        else if (target.tagName === "BUTTON" && target.textContent.trim().toLowerCase() === "save") {
            const row = target.closest("tr");
            const inputs = row.querySelectorAll("input");

            const updatedData = {};
            inputs.forEach((input, index) => {
                updatedData[`field${index}`] = input.value;
            });

            // Example: get employee number as unique ID (adjust based on actual column index)
            updatedData.empno = inputs[3]?.value || "";

            try {
                const response = await fetch('/update-single-payroll', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(updatedData)
                });

                if (response.ok) {
                    // Replace inputs with plain text
                    inputs.forEach(input => {
                        input.parentElement.textContent = input.value;
                    });

                    target.textContent = "Modify";
                } else {
                    alert("Failed to update payroll.");
                }
            } catch (error) {
                console.error("Error updating payroll:", error);
                alert("Error while saving data.");
            }
        }
    });
});
        
