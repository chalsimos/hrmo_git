      });
  $(document).ready(function () {
   
    function checkDeviceStatus(ip, cardElement) {
      $.ajax({
        url: "/check-device",
        type: "GET",
        data: { ip: ip },
        success: function (data) {
          const status = data.status === "Online" ? "bg-success" : "bg-danger";
          const responseTime = data.time ? `Response Time: ${data.time} ms` : "";

         
          $(cardElement)
            .removeClass("bg-secondary bg-success bg-danger")
            .addClass(status)
            .find(".status")
            .html(`${data.status} ${responseTime}`);
        },
        error: function () {
         
          $(cardElement)
            .removeClass("bg-secondary bg-success")
            .addClass("bg-danger")
            .find(".status")
            .text("Offline (Error)");
        }
      });
    }

   
    setInterval(function () {
      $(".small-box").each(function () {
        const ip = $(this).data("device-ip");
        checkDeviceStatus(ip, this);
      });
    }, 5000);
  });
  document.addEventListener('click', function (e) {
  if (e.target.closest('.edit-ip-btn')) {
    const button = e.target.closest('.edit-ip-btn');
    const ipAddress = button.getAttribute('data-ip');
    const deviceName = button.getAttribute('data-name');

   
    document.getElementById('deviceIp').value = ipAddress;
    document.getElementById('deviceName').value = deviceName;

   
    $('#editDeviceModal').modal('show');
  }
});
document.getElementById('addDeviceForm').addEventListener('submit', function(e){
  e.preventDefault();
  const ipAddress = document.getElementById('deviceIp').value;
  const deviceName = document.getElementById('deviceName').value;
  fetch('/add-device', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ ip: ipAddress, name: deviceName })
    })
    .then(response => response.json())
    .then(data => {
        if (data.ip && data.name) {
           
            const deviceBox = document.querySelector(`div[data-device-ip="${ipAddress}"]`);
            deviceBox.querySelector('h3').textContent = newIpAddress;
            deviceBox.querySelector('p').textContent = deviceName;
            $('#addevice').modal('hide');
        } else {
            alert('Error saving device information');
        }
    })
    .catch(err => alert('Error updating device'));
});
document.getElementById('editDeviceForm').addEventListener('submit', function (e) {
    e.preventDefault();

    const ipAddress = document.getElementById('deviceIp').value;
    const newIpAddress = document.getElementById('newDeviceIp').value;
    const deviceName = document.getElementById('deviceName').value;

    fetch('/update-device', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ ip: ipAddress, newIp: newIpAddress, name: deviceName })
    })
    .then(response => response.json())
    .then(data => {
        if (data.ip && data.name) {
           
            const deviceBox = document.querySelector(`div[data-device-ip="${ipAddress}"]`);
            deviceBox.querySelector('h3').textContent = newIpAddress;
            deviceBox.querySelector('p').textContent = deviceName;
            $('#editDeviceModal').modal('hide');
        } else {
            alert('Error saving device information');
        }
    })
    .catch(err => alert('Error updating device'));
});

</script>
