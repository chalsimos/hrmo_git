<aside class="main-sidebar sidebar-dark-primary elevation-4">
    <!-- Brand Logo -->
    <a href="/main" class="brand-link">
      <img src="/minsu.png" alt="AdminLTE Logo" class="brand-image img-circle elevation-3" style="opacity: 0.8" />
      <span class="brand-text font-weight-light">HRMgmt</span>
    </a>
  
    <!-- Sidebar -->
    <div class="sidebar">
      <!-- Sidebar user panel (optional) -->
      <div class="user-panel mt-3 pb-3 mb-3 d-flex">
        <div class="image">
          <% if (user) { %>
            <img src="/inc/dist/img/user2-160x160.jpg" class="img-circle elevation-2" alt="User Image" />
          <% } else { %>
            <img src="/path/to/default/user/image.jpg" class="img-circle elevation-2" alt="Default User Image" />
          <% } %>
        </div>
        <div class="info">
          <% if (user) { %>
            <a href="#" class="d-block"><%= user.name %></a>
          <% } else { %>
            <a href="#" class="d-block">Guest</a>
          <% } %>
        </div>
      </div>
  
      <!-- SidebarSearch Form -->
      <div class="form-inline">
        <div class="input-group" data-widget="sidebar-search">
          <input class="form-control form-control-sidebar" type="search" placeholder="Search" aria-label="Search" />
          <div class="input-group-append">
            <button class="btn btn-sidebar">
              <i class="fas fa-search fa-fw"></i>
            </button>
          </div>
        </div>
      </div>
  
      <!-- Sidebar Menu -->
      <nav class="mt-2">
        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
          <% if (user && user.role === 'accounting') { %>
            <li class="nav-item">
              <a href="/accounting/salary" class="nav-link">
                <i class="far fa-circle nav-icon"></i>
                <p>Salary</p>
              </a>
            </li>
            <li class="nav-item">
                <a href="#" data-toggle="modal" class="nav-link" data-target="#payroll">
                  <i class="nav-icon fas fa-receipt"></i>
                  <p>Payroll</p>
                </a>
              </li>
              <li class="nav-item">
                <a href="/accounting/deduction" class="nav-link">
                  <i class="far fa-circle nav-icon"></i>
                  <p>Deductions</p>
                </a>
              </li>
          <% } %>
           
          <li class="nav-item">
            <a href="/logout" class="nav-link">
              <i class="nav-icon fa fa-sign-out"></i>
              <p>Logout</p>
            </a>
          </li>
        </ul>
      </nav>
      <!-- /.sidebar-menu -->
    </div>
    <!-- /.sidebar -->
  </aside>
   <script>
      document.addEventListener('keydown', (event) => {
        if (event.ctrlKey && event.key === 'l') {
          // Call server to lock the session
          fetch('/lock-session', { method: 'POST' })
            .then(() => window.location.href = '/lock'); // Redirect to lock page
        }
      });
    </script>