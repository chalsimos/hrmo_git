<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title><%= month %> - <%= year %></title>
   <style>
  @media print {
    #page-footer {
      display: none;
    }
  }
  @page {
    /* size: 105mm 297.4mm; */
    size: 8.5in 13in;
  }
  body {
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 0.5fr 0.5fr;
    height: auto;
  }
  .column{
    padding: 10px;
  }
  table {
    border-collapse: collapse;
    border: 1px solid black;
    table-layout: fixed;
    width: 100%;
  }
  td.dotted{
    border: 1px dotted black;
  }
  .dotted-line {
    border-style: dotted;
    border-width: 1px;
    border-color: #ccc;
  }
  hr {
    border: none;
    border-top: 1px solid;
    height: 1px;
    margin-top: 1px;
    margin-bottom: 5px;
  }
  .fth{
    width:30px;
  }
  .line {
      border-top: 1px solid black;
      width: 50%;
      margin: 0 auto;
    }
  </style>
</head>
<body>
  <% 
    let totalLateMinutes = 0; 
    const one = ["01", "03", "05", "07", "08", "10", "12"];
    const num = one.includes(month) ? 31 : 30;

    employees.forEach(employee => {
      let lateMinutes1to10 = 0;
      let lateMinutes11to25 = 0;
      let lateMinutes26to31 = 0;
  %>
    <div class="column">
      <p>
        Civil Service Form No. 48 &emsp;&emsp;Card No. <%= employee.empno %>
      </p>
      <div style="text-align: center;">
        <h3>DAILY TIME RECORD</h3>
        <b>
          <%= employee.lname.toUpperCase() %>, <%= employee.fname.toUpperCase() %>
          <%= employee.mname ? employee.mname[0].toUpperCase() : '' %>
        </b>
        <hr>
        <p>(NAME)</p>
        <b><%= employee.area.toUpperCase() %></b>
        <hr>
        <p>(DIVISION)</p>
      </div>
      <p>
        For the month of <u><%= month %> <%= year %></u><br>
        Official hours for arrival and departure:
      </p>
      <table>
        <tr>
          <th rowspan="2" class="fth">Day</th>
          <th colspan="2">A.M.</th>
          <th colspan="2">P.M.</th>
          <th colspan="2">Undertime</th>
        </tr>
        <tr>
          <td>Arrival</td>
          <td>Departure</td>
          <td>Arrival</td>
          <td>Departure</td>
          <td>Hours</td>
          <td>Minutes</td>
        </tr>

        <% 
        let employeeTotalLateMinutes = 0;
        for (let i = 1; i <= num; i++) {
          const date = new Date(year, month - 1, i).toISOString().slice(0, 10); 
          let hasData = false;
          let lateHours = 0;
          let lateMinutes = 0;

          const dayData = dataset.find(d => d.date === date && d.sid === employee.empno);
          if (dayData && dayData.am_time_in) {
            hasData = true;
            const scheduledTime = new Date('1970-01-01T08:00:00');
            const actualTimeIn = new Date('1970-01-01T' + dayData.am_time_in);

            if (actualTimeIn > scheduledTime) {
              const interval = actualTimeIn - scheduledTime;
              lateHours = Math.floor(interval / 3600000);
              lateMinutes = Math.floor((interval % 3600000) / 60000);
              employeeTotalLateMinutes += lateMinutes;

              if (i >= 1 && i <= 10) {
                lateMinutes1to10 += lateMinutes;
              } else if (i >= 11 && i <= 25) {
                lateMinutes11to25 += lateMinutes;
              } else if (i >= 26 && i <= 31) {
                lateMinutes26to31 += lateMinutes;
              }
            }
          }
        %>
          <tr>
            <td class="dotted"><%= i %></td>
            <% if (hasData) { %>
              <td class="dotted"><%= dayData.am_time_in || '0' %></td>
              <td class="dotted"><%= dayData.am_time_out || '0' %></td>
              <td class="dotted"><%= dayData.pm_time_in || '0' %></td>
              <td class="dotted"><%= dayData.pm_time_out || '0' %></td>
              <td class="dotted"><%= lateHours %></td>
              <td class="dotted"><%= lateMinutes %></td>
            <% } else { %>
              <td class="dotted"></td>
              <td class="dotted"></td>
              <td class="dotted"></td>
              <td class="dotted"></td>
              <td class="dotted"></td>
              <td class="dotted"></td>
            <% } %>
          </tr>
        <% } %>
        <% totalLateMinutes += employeeTotalLateMinutes; %>
        
      </table>
      <p>
        I certify on my honor that the above is a true and correct report of the hours of work performed, recorded daily.
      </p>
      <p>
        <u>______________________________________________</u><br>
        (Employee's Signature)
      </p>
      <p>
        Verified as to the prescribed office hours:<br><br>
        <center>
        <u>______________________________________________</u><br>
        <b><%= signatory.name.toUpperCase() %></b><br>
        <i><%= signatory.position.toUpperCase() %></i>
        </center>
      </p>
    </div>
  <% }); %>
</body>
</html>
