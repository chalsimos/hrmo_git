<%- include('../partials/top') %>
<body class="hold-transition sidebar-mini layout-fixed">
  <div class="wrapper">
    <%- include('../partials/nav') %> <%- include('../partials/aside') %>
    <div class="content-wrapper">
      <section class="content-header">
        <div class="container-fluid">
          <div class="row mb-2">
            <div class="col-sm-6">
              <h1>General Form</h1>
            </div>
            <div class="col-sm-6">
              <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="#">Home</a></li>
                <li class="breadcrumb-item active">General Form</li>
              </ol>
            </div>
          </div>
        </div>
        <!-- /.container-fluid -->
      </section>

      <section class="content">
        <div class="container-fluid">
          <div class="row">
            <div class="card card-success">
              <div class="card-header">
                <h3 class="card-title">Register new Employee</h3>
              </div>

              <form
                action="/modify-employee/<%= data.emp.empno %>"
                method="POST"
              >
                <div class="card-body">
                  <% if (messages && messages.success) { %>
                  <div class="alert alert-success"><%= messages.success %></div>
                  <% } %>

                  <div class="row">
                    <div class="col-4">
                      <label for="lastname">lastname</label>
                      <input
                        type="text"
                        class="form-control"
                        placeholder="Last Name"
                        name="lname"
                        value="<%= data.emp.lname %>"
                        required
                      />
                    </div>
                    <div class="col-4">
                      <label for="FirstName">FirstName</label>
                      <input
                        type="text"
                        class="form-control"
                        placeholder="First Name"
                        name="fname"
                        value="<%= data.emp.fname %>"
                        required
                      />
                    </div>
                    <div class="col-4">
                      <label for="MiddleName">MiddleName</label>
                      <input
                        type="text"
                        class="form-control"
                        placeholder="Middle Name"
                        name="mname"
                        value="<%= data.emp.mname %>"
                        required
                      />
                    </div>
                  </div>
                  <div class="row">
                    <div class="col-6">
                      <label>Birthdate</label>
                      <input
                        type="date"
                        name="birthdate"
                        class="form-control"
                        value="<%= data.emp.birthdate %>"
                        required
                      />
                    </div>
                    <div class="col-6">
                      <label>Birth Place</label>
                      <input
                        type="text"
                        name="birthplace"
                        class="form-control"
                        placeholder="birthplace"
                        value="<%= data.emp.birthplace %>"
                        required
                      />
                    </div>
                  </div>
                  <div class="row">
                    <div class="col-md-4">
                      <label>CATEGORY TYPE</label>
                      <select class="form-control" name="cat_type" required>
                        <!-- <option value="ADMIN">ADMIN</option>
                            <option value="JOBORDER">JOB ORDER</option>
                            <option value="NONPERMANENT">NON-PERMANENT</option>
                            <option value="FACULTY">FACULTY</option> -->
                        <option value="Job Order">JOB ORDER</option>
                        <option value="COS">COS</option>
                        <option value="PERMANENT">PERMANENT</option>
                      </select>
                    </div>

                    <div class="col-md-4">
                      <label>AREA TYPE</label>
                      <select class="form-control" name="area" required>
                        <option value="FACULTY">FACULTY</option>
                        <option value="Admin Aide">ADMINISTRATIVE AIDE</option>
                        <option value="Admin Officer">ADMINISTRATIVE OFFICER</option>
                      </select>
                    </div>

                    <div class="col-md-4">
                      <label>Employee ID</label>
                      <input
                        type="text"
                        name="empno"
                        value="<%= data.emp.empno %>"
                        class="form-control"
                        required
                      />
                    </div>
                  </div>
                  <!-- <div class="row">
                    <div class="col-md-6">
                      <label>Deductions [MANDATORY]</label>
                      <select name="deduction" class="form-control">
                        <option value="sss">SSS</option>
                        <option value="philhealth">PhilHeath</option>
                        <option value="pagibig">PagIbig</option>
                      </select>
                    </div>
                    <div class="col-md-6">
                      <label>Amounting Value</label>
                      <input type="number" class="form-control" name="avalue" />
                    </div>
                  </div> -->
                  <div class="row">
                  <div class="col-md-6">
                    <label>Schedule/Time</label> <a href="/help/flexitime">help</a>
                    <select name="schedule" class="form-control">
                      <option value="7AM">7:00 - 12:00 | 1:00 - 4:00</option>
                    <option value="8AM">8:00 - 12:00 | 1:00 - 5:00</option>
                    <option value="9AM">9:00 - 1:00 | 2:00 - 6:00</option>
                    </select>
                  </div>
                </div>
                </div>
                
                <!-- /.card-body -->

                <div class="card-footer">
                  <button type="submit" class="btn btn-primary">Submit</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </section>

      <section class="content">
        <div class="container-fluid">
          <div class="row">
            <div class="col-12">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">Employee Listings</h3>
                </div>
                <!-- /.card-header -->
                <div class="card-body">
                 <table>
  <thead>
    <tr>
      <th>Deduction</th>
      <th>Value</th>
    </tr>
  </thead>
  <tbody>
    <% if (data.deductions && data.deductions.length > 0) { %>
      <% data.deductions.forEach(deduction => { %>
        <tr>
          <td><%= deduction.deduction %></td>
          <td><%= deduction.avalue %></td>
          <td> </td>
        </tr>
      <% }) %>
    <% } else { %>
      <tr>
        <td colspan="2">No deductions available for this employee.</td>
      </tr>
    <% } %>
  </tbody>
</table>

                </div>
                <!-- /.card-body -->
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
  <%- include('../partials/end') %>
</body>
