<%- include('../partials/top') %>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper"> 
        <%- include('../partials/nav') %>
        <%- include('../partials/aside') %>
        <div class="content-wrapper">
            <section class="content-header">
                <div class="container-fluid">
                  <div class="row mb-2">
                    <div class="col-sm-6">
                      <h1>Employee</h1>
                    </div>
                    <div class="col-sm-6">
                      <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item active">employee</li>
                      </ol>
                    </div>
                  </div>
                </div><!-- /.container-fluid -->
              </section>
      
              <section class="content">
                <div class="container-fluid">
                  <div class="row">
                    <div class="col-12">
                      <div class="card">
                        <div class="card-header">
                          <h3 class="card-title">Employee Listings</h3>
                        </div>
                        <!-- /.card-header -->
                        <div class="card-body">
                          <table id="example1" class="table table-bordered table-striped">
                            <thead>
                              <tr>
                                <th>EMP ID</th>
                                <th>Name</th>
                                <th>Department</th>
                                <th>Status</th>
                              </tr>
                            </thead>
                            <tbody>
                              <% employees.forEach(employee => { %>
                                <tr>
                                  <td><%= employee.empno %></td>
                                  <td>
                                    <a href="#" onclick="openModal('modal2', '<%= employee.fname %>', '<%= employee.lname %>', '<%= employee.sid %>', '<%= employee.mname %>')">
                                      <%= employee.lname %>, <%= employee.fname %>
                                    </a>
                                  </td>
                                  <td><%= employee.dept %></td>
                                  <td>
                                    <input 
                                      type="checkbox" 
                                      name="status" 
                                      class="status" 
                                      data-name="<%= employee.fname + ' ' + employee.lname %>"
                                      data-id="<%= employee.sid %>"
                                      value="<%= employee.status %>" 
                                      <%= employee.status === 'active' ? 'checked' : '' %> 
                                    >
                                    <a data-toggle="modal" data-id="<%= employee.empno %>" data-target="#addBookDialog" class="pritil">export</a>
                                  </td>
                                </tr>
                              <% }); %>
                            </tbody>
                            <tfoot>
                              <tr>
                                <th>EMP ID</th>
                                <th>Name</th>
                                <th>Department</th>
                                <th>Status</th>
                              </tr>
                            </tfoot>
                          </table>
              
                          <!-- Add Book Dialog Modal -->
                          <!-- Add Book Dialog Modal -->
<div id="addBookDialog" class="modal fade" role="dialog">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="modal-title">Export Data</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="myForm" method="post" action="/dtrperemp">
          <input type="hidden" name="sid" id="ssid">
          <div class="row">
            <div class="col-lg-12">
              <label>Year</label>
              <select class="form-control" name="year">
                <% for (let curyear = new Date().getFullYear(), baseYear = 2019; curyear >= baseYear; curyear--) { %>
                  <option value="<%= curyear %>"><%= curyear %></option>
                <% } %>
              </select>
              <input type="checkbox" name="computation">include computation
            </div>
          </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary">Filter</button>
      </div>
    </div>
  </div>
</div>

              
                          <!-- Modal 2 (Modify Employee Modal) -->
                          <div id="modal2" class="modal">
                            <div class="modal-dialog">
                              <div class="modal-content">
                                <div class="modal-header">
                                  <h5 class="modal-title">Modify</h5>
                                  <span class="close" onclick="closeModal('modal2')">&times;</span>
                                </div>
                                <div class="modal-body">
                                  <form id="myForm" method="post" action='/modifyemp'>
                                    <input type="hidden" id="sid" name="emp">
                                    <div class="row">
                                      <div class="col-lg-4">
                                        <label>LastName</label>
                                        <input type="text" name="lastName" id="lastName" class="form-control">
                                      </div>
                                      <div class="col-lg-4">
                                        <label>FirstName</label>
                                        <input type="text" name="firstName" id="firstName" class="form-control">
                                      </div>
                                      <div class="col-lg-3">
                                        <label>Middle Initial</label>
                                        <input type="text" name="middleName" id="middleName" class="form-control">
                                      </div>
                                    </div>
                                    <div class="row">
                                      <div class="col-lg-3">
                                        <label>EmpID</label>
                                        <input type="text" name="empid" id="empid" class="form-control">
                                      </div>
                                      <div class="col-lg-5">
                                        <label>Department</label>
                                        <select class="form-control" name="dept" required>
                                          <option value="ADMIN">ADMIN</option>
                                          <option value="JOBORDER">JOB ORDER</option>
                                          <option value="NONPERMANENT">NON-PERMANENT</option>
                                          <option value="FACULTY">FACULTY</option>
                                        </select>
                                      </div>
                                      <div class="col-lg-3">
                                        <label>Status</label>
                                        <select class="form-control" name="status" required>
                                          <option value="active">active</option>
                                          <option value="inactive">inactive</option>
                                        </select>
                                      </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                  <button type="submit" class="btn btn-primary">save changes</button>
                                </div>
                              </form>
                              </div>
                            </div>
                          </div>
              
                        </div>
                        <!-- /.card-body -->
                      </div>
                    </div>
                  </div>
                </div>
              </section>
              
          </div>
        </div>
        <%- include('../partials/end') %>
        <script>
          document.addEventListener("DOMContentLoaded", function () {
  // Attach a click event to all elements with the class "pritil"
  const exportLinks = document.querySelectorAll(".pritil");

  exportLinks.forEach(link => {
    link.addEventListener("click", function (event) {
      // Prevent default action
      event.preventDefault();

      // Get the SID from the data-id attribute
      const sid = this.getAttribute("data-id");

      // Set the SID in the modal's hidden input field
      const sidInput = document.getElementById("ssid");
      if (sidInput) {
        sidInput.value = sid;
      }

      // Optionally set the modal title or other fields if needed
      const modalTitle = document.getElementById("modal-title");
      if (modalTitle) {
        modalTitle.textContent = `Export Data for SID: ${sid}`;
      }

      // Show the modal (Bootstrap 5)
      const modalElement = document.getElementById("addBookDialog");
      if (modalElement) {
        const bootstrapModal = new bootstrap.Modal(modalElement);
        bootstrapModal.show();
      }
    });
  });
});
</script>