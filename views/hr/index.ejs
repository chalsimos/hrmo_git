                            <tfoot>
                              <tr>
                                <th>EMP ID</th>
                                <th>Name</th>
                                <th>Department</th>
                                <th>Action</th>
                              </tr>
                            </tfoot>
                          </table>
                          
                          
              
                          <!-- Add Book Dialog Modal -->

                          <div class="modal fade" id="modify" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                              <div class="modal-content">
                                <div class="modal-header">
                                  <button type="button" class="close" data-dismiss="modal">&times;</button>
                                </div>
                                <div class="modal-body">
                                  <h2 id="modal-title"></h2>
                                  <form id="myForm" method="get" action='/filteryear'>
                                    <input type="hidden" class="form-control" name="empno" id="employeeIdInput" readonly>
                                    <p><b>Name: <span id="nameText"></span></b></p>
                                    <div class="row">
                                      
                                      <div class="col-lg-6">
                                        
                                        <label>Year</label>
                                        <select class="form-control" name="year">
                                          <% for (let curyear = new Date().getFullYear(), baseYear = 2019; curyear >= baseYear; curyear--) { %>
                                            <option value="<%= curyear %>"><%= curyear %></option>
                                          <% } %>
                                        </select>
                                      </div>
                                      <div class="col-lg-6">
                                        <label for="month">month</label>
                                        <select name="month" class="form-control">
                                          <% 
                                              const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
                                              for (let i = 0; i < months.length; i++) { 
                                          %>
                                              <option value="<%= i + 1 %>"><%= months[i] %></option>
                                          <% } %>
                                      </select>
                                      </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                  <button type="submit" class="btn btn-primary">Filter</button>
                                </div>
                              </div>
                            </form>
                            </div>
                          </div>
                          <!-- end of modify -->


                          <!-- leave start here -->
