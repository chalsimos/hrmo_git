                                </div>
                                <div class="modal-body">
                                  <h2 id="modal-title"></h2>
                                  <form id="myForm" method="post" action='/add-service-record'>
                                    
                                    <input type="text" class="form-control" name="empno" id="eid" readonly>
                                    <p><b>Name: <span id="namesrv"></span></b></p>
                                    <input type="hidden" name="empname" id="srvname">
                                    <!-- <input type="text" name="empno" id="emp"> -->
                                     <a id="viewServiceLink" href="/service-record/here?">View Service Record</a>
                                    <div class="row">
                                      <div class="col-lg-6">
                                        <label for="started">Date started:</label>
                                        <input type="date" class="form-control" name="start" required>
                                      </div>
                                      <div class="col-lg-6">
                                        <label for="end">Date ended:</label>
                                        <input type="date" class="form-control" name="end" required>
                                      </div>
                                    </div>
                                    <div class="row">
                                      <div class="col-md-6">
                                        <label for="type">Service type</label>
                                        <select name="type" id="type" class="form-control">
                                          <option value="JO">JO</option>
                                          <option value="COS">COS</option>
                                          <option value="PERMANENT">PERMANENT</option>
                                        </select>
                                      </div>
                                      <div class="col-md-6">
                                        <label for="position">Position</label>
                                        <select name="position" class="form-control" id="position">
                                          <% data.position.forEach(position => { %>
                                            <option value="<%= position.name %>"><%= position.name %></option>
                                          <% }) %>
                                        </select>
                                      </div>
                                    </div>
                                    <div class="row">
                                      <div class="col-md-4">
                                        <label for="">Salary Grade</label>
                                        <select name="salaryGrade" id="" class="form-control">
                                          <option value="NA">N/A</option>
                                          <% for(let i= 9; i<=25; i++) { %> 
                                          <option value="<%= i%>"><%= i%></option>
                                          <%} %>
                                        </select>
                                      </div>
                                      <div class="col-md-4">
                                        <label for="">Tranch</label>
                                        <select name="tranch" id="" class="form-control">
                                          <option value="NA">N/A</option>
                                          <% for(let i= 1; i<=6; i++) { %> 
                                          <option value="<%= i%>"><%= i%></option>
