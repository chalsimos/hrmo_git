<%- include('../partials/top') %>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper"> 
        <%- include('../partials/nav') %>
        <%- include('../partials/aside') %>
        <div class="content-wrapper">
            <section class="content-header">
                <div class="container-fluid">
                  <div class="row mb-2">
                    <div class="col-sm-6">
                      <h1>Payroll</h1>
                    </div>
                    <div class="col-sm-6">
                      <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item active">payroll</li>
                      </ol>
                    </div>
                  </div>
                </div><!-- /.container-fluid -->
              </section>
      
             <section class="content">
                <div class="container-fluid">
                    <!-- end ng devices -->
                    
                    <h1>Payroll for the Month of: <%= new Date(year || 2024, (month || 1) - 1, 1).toLocaleString('en-US', { month: 'long', year: 'numeric' }) %> </h1>
                    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#publishModal">
                      Publish to Accounting
                    </button>
                    <br><br>
                    <!-- Publish Confirmation Modal -->
                    <!-- Publish Confirmation Modal -->
                      <div class="modal fade" id="publishModal" tabindex="-1" role="dialog" aria-labelledby="publishModalLabel" aria-hidden="true">
                        <div class="modal-dialog" role="document">
                          <div class="modal-content">
                            <div class="modal-header">
                              <h5 class="modal-title" id="publishModalLabel">Confirm Publish</h5>
                              <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                              </button>
                            </div>
                            <div class="modal-body">
                              <form id="publishForm">
                                <div class="form-group">
                                  <label for="password">Enter your password to confirm:</label>
                                  <input type="password" class="form-control" id="password" name="password" required>
                                </div>
                              </form>
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                              <button type="button" class="btn btn-primary" id="confirmPublish">Confirm</button>
                            </div>
                          </div>
                        </div>
                      </div>
                  <div class="row">
                    <div class="col-12">
                      <% if (typeof successMessage !== 'undefined' && successMessage.length > 0) { %>
                        <div class="alert alert-success">
                          <%= successMessage %>
                        </div>
                      <% } %>

                      <% if (typeof errorMessage !== 'undefined' && errorMessage.length > 0) { %>
                        <div class="alert alert-danger">
                          <%= errorMessage %>
                        </div>
                      <% } %>
                    </div>
                  </div>

                  <div class="row">
                    <div class="col-12">
                      <div class="card">
                        <div class="card-header">
                          <h3 class="card-title">PERMANENT</h3>
                        </div>
                        <!-- /.card-header -->
                        <div class="card-body p-0">
                          <div class="table-responsive" style="max-height: 500px; overflow: auto;">
                            <table id="faculty" class="table table-bordered table-striped mb-0" style="table-layout: fixed; width: 100%;">
                              <thead style="position: sticky; top: 0; background-color: #f8f9fa; z-index: 1;">
                                <tr>
                                  
                                  <th style="width: 120px;">Name</th>
                                  <th colspan="3" style="width: 180px;">Time</th>
                                  <th colspan="4" style="width: 240px;">Salary Rates</th>
                                  <th colspan="4" style="width: 240px;">PERA Rates</th>
                                  <th colspan="4" style="width: 240px;">SALARY DEDUCTIONS</th>
                                  <th colspan="5" style="width: 240px;">PERA DEDUCTIONS</th>
                                  <th style="width: 100px;">Action</th>
                                </tr>
                                <tr>
                                  
                                  <td></td>
                                  <td style="width: 20px;">Days</td>
                                  <td style="width: 20px;">Hours</td>
                                  <td style="width: 20px;">Minutes</td>
                                  <td style="width: 60px;">Monthly Rate</td>
                                  <td style="width: 60px;">Rate/Day</td>
                                  <td style="width: 60px;">Rate/Hour</td>
                                  <td style="width: 60px;">Rate/Minute</td>
                                  <td style="width: 60px;">PERA</td>
                                  <td style="width: 60px;">Rate/Day</td>
                                  <td style="width: 60px;">Rate/Hour</td>
                                  <td style="width: 60px;">Rate/Minute</td>
                                  <td style="width: 60px;">Amt/day</td>
                                  <td style="width: 60px;">Amt/hr</td>
                                  <td style="width: 60px;">Amt/min</td>
                                  <td style="width: 60px;">Total</td>
                                  <td style="width: 60px;">Amt/day</td>
                                  <td style="width: 60px;">Amt/hr</td>
                                  <td style="width: 60px;">Amt/min</td>
                                  
                                  <td style="width: 60px;">Total</td>                             
                                  <td style="width: 100px;">Grand <br>Total</td>
                                </tr>
                              </thead>
                              <tbody>
                                <% data.permanent.forEach(employee => { %>
                                  <tr>
                                    <% 
                                    const empAbsence = data.absences.find(abs => abs._id === employee.empno) || { absencesCount: 0, absenceDates: [] };
                                    const ndays = empAbsence.absencesCount;
                                    const absenceDatesTooltip = empAbsence.absenceDates.join(", ");
                                      const nsalary = Number(employee.salary);
                                      const dsalary = nsalary / 22;
                                      const hsalary = dsalary / 8;
                                      const msalary = hsalary / 60;
                                  
                                     
                                      const lateEntry = data.lateEntries.find(le => le._id == employee.empno) || { totalLateMinutes: 0 };
                                  
                                      const totalLate = Number(lateEntry.totalLateMinutes) || 0;
                                      <!-- const ndays = Math.floor(totalLate / 480); -->
                                      const remainingMinutes = totalLate % 480;
                                      const nhrs = Math.floor(remainingMinutes / 60);
                                      const nmin = remainingMinutes % 60;
                                  
                                      const pera = 2000;
                                      const dailyRatePera = Math.round((pera / 22) * 100) / 100;
                                      const hpera = (dailyRatePera / 8).toFixed(2);
                                      const mpera = (hpera / 60).toFixed(2);
                                  
                                      const dsdeduction = dsalary * ndays;
                                      const hsdeduction = hsalary * nhrs;
                                      const msdeduction = msalary * nmin;
                                      const stotalDeduction = dsdeduction + hsdeduction + msdeduction;
                                  
                                      const dpdeduction = dailyRatePera * ndays;
                                      const hpdeduction = hpera * nhrs;
                                      const mpdeduction = mpera * nmin;
                                      const ptotalDeduction = dpdeduction + hpdeduction + mpdeduction;
                                    %>
                                    
                                    <td><%= employee.name %></td>
                                    <td> <span 
                                      data-bs-toggle="tooltip" 
                                      data-bs-html="true" 
                                      title="Absent Dates: <%= absenceDatesTooltip %>">
                                      <b><%= ndays %></b>
                                    </span></td>
                                    <td><b><%= nhrs %></b></td>
                                    <td><b><%= nmin %></b></td>
                                  
                                    <td><%= nsalary.toFixed(2) %></td>
                                    <td><%= dsalary.toFixed(2) %></td>
                                    <td><%= hsalary.toFixed(2) %></td>
                                    <td><%= msalary.toFixed(2) %></td>
                                    <td><%= pera.toFixed(2) %></td>
                                    <td><%= dailyRatePera.toFixed(2) %></td>
                                    <td><%= hpera %></td>

                                    <td><%= mpera  %></td>

                                    <!-- salary deduction -->
                                    <td><%= dsdeduction.toFixed(2) %></td>
                                    <td><%= hsdeduction.toFixed(2) %></td>
                                    <td><%= msdeduction.toFixed(2) %></td>
                                    <td><b><%= stotalDeduction.toFixed(2) %></b></td>
                                    <td><%= dpdeduction.toFixed(2) %></td>
                                    <td><%= hpdeduction.toFixed(2) %></td>
                                    <td><%= mpdeduction.toFixed(2) %></td>
                                    <td><%= ptotalDeduction.toFixed(2) %></td>
                                    <td><%= (ptotalDeduction+stotalDeduction).toFixed(2) %></td>
                                    
                                    <td>
                                      <a href="/filteryear?empno=<%= employee.empno %>&year=<%= year %>&month=<%= month %>">modify</a>
                                    </td>
                                  </tr>
                                  <% }); %>
                                  
                            </tbody>
                            </table>
                          </div>
                        </div>
                        <!-- /.card-body -->
                      </div>
                    </div>
                  </div>
                </div>
