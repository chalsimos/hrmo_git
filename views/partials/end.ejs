<script>
    
$(document).ready(function() {
    $(document).on('click', '.export-btn', function() {
        var employeeId = $(this).data('id');
        var empName = $(this).data('names');
        $('#modify').modal('show');
        $('#employeeIdInput').val(employeeId);
        $('#nameText').text(empName);
    });
    $(document).on('click', '.leave', function() {
      var employeeId = $(this).data('id');
      var empName = $(this).data('names');
      $('#leave').modal('show');
      $('#leaveInput').val(employeeId);
      $('#leaveText').text(empName);
      $('#leaveName').val(empName);
      
  });
    $(document).on('click', '.export-srvrcd', function() {
      
        var empid = $(this).data('id');
        var empName = $(this).data('names');
        $('#srvrcd').modal('show');
        $('#eid').val(empid);
        $('#namesrv').text(empName);
        $('#srvname').val(empName);
        $('#emp').val(empid);
        $('a#viewServiceLink').attr('href', '/service-record/' + empid); 

        
    });
});


  $(function () {
