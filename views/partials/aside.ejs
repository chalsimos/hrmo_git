 <script>
    document.addEventListener('keydown', (event) => {
      if (event.ctrlKey && event.key === 'l') {
        // Call server to lock the session
        fetch('/lock-session', { method: 'POST' })
          .then(() => window.location.href = '/lock'); // Redirect to lock page
      }
    });
  </script>