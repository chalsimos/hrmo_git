<!-- views/index.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CRUD App</title>
</head>
<body>
    <h1>Book List</h1>
    <form action="/books" method="POST">
        <input type="text" name="title" placeholder="Title" required>
        <input type="text" name="author" placeholder="Author" required>
        <input type="date" name="publishedDate" placeholder="Published Date" required>
        <button type="submit">Add Book</button>
    </form>
    <ul>
        <% books.forEach(function(book) { %>
            <li>
                <strong><%= book.title %></strong> by <%= book.author %> (Published on: <%= book.publishedDate.toDateString() %>)
                <a href="/books/edit/<%= book._id %>">Edit</a>
                <a href="/books/delete/<%= book._id %>">Delete</a>
            </li>
        <% }); %>
    </ul>
   
    <form action="/upload" method="POST" enctype="multipart/form-data">
        <input type="file" name="file" accept=".dat" required />
        <button type="submit">Upload</button>
      </form>
</body>
</html>
